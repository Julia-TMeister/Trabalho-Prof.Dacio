#include <stdio.h>
#include <stdlib.h>
// Essa estrutura funciona como um armazenamento das informações da partida
struct Jogo {
    int dia; //Guarda em qual dia da história o jogador está
    int pistas; //Conta quantas pistas foram encontradas
    int escolha; //Armazena uma escolha específica do jogador
    int chaveVista; //Registra se Juliano já viu a chave diferente
    int chaveIdentificada; //Registra se o jogador identificou a possível função da chave
    int escolhas[10]; //Armazena algumas decisões realizadas durante a partida
};

//Variavel Global - permite que diferentes funções acessem e atualizem as informações da mesma partida
struct Jogo jogo;


void inicializarJogo() { // evita que o jogo comece com informações incorretas ou valores que não foram definidos
	int i;
    jogo.dia = 1; 
    jogo.pistas = 0; 
    jogo.escolha = 0;
    jogo.chaveVista = 0;
    jogo.chaveIdentificada = 0;

    for (i = 0; i < 10; i++) { //Evita que o vetor comece com valores aleatórios na memória
        jogo.escolhas[i] = 0;
    }
}

int lerOpcao(int minimo, int maximo) { //controlar as respostas 

    int opcao;
//evita que o jogador escolha um número que não existe entre as alternativas apresentadas
    do { 
        printf("\nEscolha: ");
        scanf("%d", &opcao);

        if (opcao < minimo || opcao > maximo) {
            printf("Opcao invalida! Tente novamente.\n");
        }

    } while (opcao < minimo || opcao > maximo);

    return opcao;
}


