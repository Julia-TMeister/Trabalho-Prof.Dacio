#include <stdio.h>
#include <stdlib.h>
// Estrutura principal do jogo
// Armazenamento das informaões da partida
struct Jogo {
    int dia;
    int pistas;
    int escolha;
    int chaveVista;
    int chaveIdentificada;
    int escolhas[10];
};
// Inicializa os valores do jogo
void inicializarJogo(struct Jogo *jogo) {
	int i;
    jogo->dia = 1;
    jogo->pistas = 0;
    jogo->escolha = 0;
    jogo->chaveVista = 0;
    jogo->chaveIdentificada = 0;
    // O vetor armazena as escolhas realizadas pelo jogador
    for (i = 0; i < 10; i++) {
        jogo->escolhas[i] = 0;
    }
}
// Funcao para validar as opcoes dos menus
int lerOpcao(int minimo, int maximo) {
    int opcao;
    do {
        printf("\nEscolha: ");
        scanf("%d", &opcao);
        if (opcao < minimo || opcao > maximo) {
            printf("Opcao invalida! Tente novamente.\n");
        }
    } while (opcao < minimo || opcao > maximo);

    return opcao;
}

