void inicializarJogo() { // evita que o jogo comece com informações incorretas ou valores que não foram definidos
	int i;
    dia = 1;      
    pistas = 0;    
    escolha = 0;
    chaveVista = 0;
    chaveIdentificada = 0;

    for (i = 0; i < 10; i++) { //Evita que o vetor comece com valores aleatórios na memória
        escolhas[i] = 0;
    }
}

int lerOpcao(int minimo, int maximo) { //controlar as respostas 

    int opcao;
//evita que o jogador escolha um número que não existe entre as alternativas apresentadas
    do { 
        printf("\nEscolha: ");
        scanf("%d", &opcao);

        if (opcao < minimo || opcao > maximo) {
            printf("Opcao invalida! Tente novamente.\n");
        }

    } while (opcao < minimo || opcao > maximo);

    return opcao;
}


